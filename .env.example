# ===== 布布记账 环境变量 =====
# 本地开发：复制为 .env.local 并填值（.env.local 已被 .gitignore 忽略）
# 云端部署：在托管平台的环境变量面板里逐条填（不要提交进仓库）

# ---- DeepSeek 识别服务 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash

# ---- 服务端口 ----
# 本地默认 8787；托管平台会自动注入 PORT，无需在这里设置
API_PORT=8787

# ===== AI 护栏（公网部署强烈建议保留默认值）=====
# 站点用的是你自己的 Key，不设限等于把额度开放给全网。
# 关掉 AI：AI_ENABLED=false（记账功能完全不受影响）
AI_ENABLED=true
# 单个 IP 每分钟 / 每天最多识别几次
AI_RATE_PER_MIN=6
AI_RATE_PER_DAY=40
# 全站每天的总次数与总 token 上限（熔断，兜底防止被刷爆）
AI_GLOBAL_PER_DAY=300
AI_GLOBAL_TOKENS_PER_DAY=1200000
# 部署在反向代理后面（Render / Railway / Nginx）必须为 true，否则所有访客会被算成同一个 IP
TRUST_PROXY=true
